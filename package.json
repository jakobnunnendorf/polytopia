{
  "name": "polytopia",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "test": "jest --watchAll",
    "lint": "expo lint",
    "simulate": "node -r sucrase/register scripts/simulate.ts",
    "test:ci": "jest --ci",
    "arena": "node -r sucrase/register scripts/arena.ts",
    "arena-server": "node -r sucrase/register scripts/arena-server.ts",
    "elo": "node -r sucrase/register scripts/elo.ts",
    "export-dataset": "node -r sucrase/register scripts/export-dataset.ts",
    "engine:build": "scripts/rust/build-engine.sh",
    "rl:gate": "PATH=\"$HOME/.cargo/bin:$PATH\" cargo run --release -q --manifest-path engine/Cargo.toml -p rl-gate --",
    "train-hill": "node -r sucrase/register scripts/train-hill.ts",
    "train-full": "node -r sucrase/register scripts/train-full.ts",
    "train-es": "node -r sucrase/register scripts/train-es.ts",
    "train-dashboard": "node -r sucrase/register scripts/train-dashboard.ts",
    "sweep": "node -r sucrase/register scripts/sweep.ts",
    "train-probe": "node -r sucrase/register scripts/train-probe.ts",
    "experiment:report": "node -r sucrase/register scripts/experiment-report.ts",
    "elo-tournament": "node -r sucrase/register scripts/elo-tournament.ts",
    "elo-dashboard": "node -r sucrase/register scripts/elo-dashboard.ts",
    "supabase:sync": "node -r sucrase/register scripts/supabase-sync.ts"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.0.2",
    "@react-native-picker/picker": "2.9.0",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.0.14",
    "expo": "~52.0.28",
    "expo-blur": "~14.0.3",
    "expo-constants": "~17.0.5",
    "expo-font": "~13.0.3",
    "expo-haptics": "~14.0.1",
    "expo-linking": "~7.0.5",
    "expo-router": "~4.0.17",
    "expo-splash-screen": "~0.29.21",
    "expo-status-bar": "~2.0.1",
    "expo-symbols": "~0.2.1",
    "expo-system-ui": "~4.0.7",
    "expo-web-browser": "~14.0.2",
    "nativewind": "^4.1.23",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.6",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-reanimated": "~3.16.1",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-web": "~0.19.13",
    "react-native-webview": "13.12.5",
    "tailwindcss": "^3.4.17",
    "react-native-svg": "15.8.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@testing-library/react-native": "^13.2.2",
    "@types/jest": "^29.5.12",
    "@types/react": "~18.3.12",
    "@types/react-test-renderer": "^18.3.0",
    "eslint": "^9.33.0",
    "eslint-config-expo": "~8.0.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-testing-library": "^7.6.4",
    "jest": "^29.2.1",
    "jest-expo": "~52.0.3",
    "prettier": "^3.6.2",
    "react-test-renderer": "18.3.1",
    "typescript": "^5.3.3"
  },
  "private": true
}
